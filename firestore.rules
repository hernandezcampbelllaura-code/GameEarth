rules_version = '2';

// Reglas de seguridad de GamingSocial (versión reforzada).
// Pégalas en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admin = existe el documento admins/<uid>. Nadie puede crearlo desde la
    // app; solo tú, a mano, desde la consola de Firebase.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Puede escribir: tiene perfil y no está baneado.
    function canWrite() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().banned != true;
    }

    // Solo se aceptan fotos/videos subidos a TU Cloudinary (o vacío).
    function okMedia(u) {
      return u is string
        && (u == '' || u.matches('https://res\\.cloudinary\\.com/hagnq5mv/.*'));
    }

    // Enlace opcional: vacío o http(s) de hasta 300 caracteres.
    function okLink(u) {
      return u is string && u.size() <= 300
        && (u == '' || u.matches('https?://[^ ]+'));
    }

    // Publicar en un grupo: vacío (publicación normal) o ser miembro.
    function okGroup(g) {
      return g is string
        && (g == ''
            || exists(/databases/$(database)/documents/groups/$(g)/members/$(request.auth.uid)));
    }

    function okText(t, maxLen) {
      return t is string && t.size() > 0 && t.size() <= maxLen;
    }

    // Un contador solo puede subir o bajar de 1 en 1.
    function step(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (request.resource.data[field] - resource.data.get(field, 0) >= -1
            && request.resource.data[field] - resource.data.get(field, 0) <= 1);
    }

    function pollTotal(m) {
      return m.get('0', 0) + m.get('1', 0) + m.get('2', 0) + m.get('3', 0);
    }

    // Votar: cambia una sola opción, suma exactamente 1 y deja el voto
    // registrado (posts/<id>/votes/<uid>), que no existía antes.
    function okVote(postId) {
      return request.resource.data.pollCounts.diff(resource.data.pollCounts)
               .affectedKeys().size() == 1
        && pollTotal(request.resource.data.pollCounts)
             - pollTotal(resource.data.pollCounts) == 1
        && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid));
    }

    // Encuesta opcional: 0 opciones, o de 2 a 4 de hasta 60 letras.
    function okPoll(opts, counts) {
      return opts is list && counts is map
        && counts.keys().size() == opts.size()
        && pollTotal(counts) == 0
        && (opts.size() == 0
            || (opts.size() >= 2 && opts.size() <= 4
                && opts[0] is string && opts[0].size() <= 60
                && opts[1] is string && opts[1].size() <= 60
                && (opts.size() < 3 || (opts[2] is string && opts[2].size() <= 60))
                && (opts.size() < 4 || (opts[3] is string && opts[3].size() <= 60))));
    }

    // Los contadores de me gusta y visitas solo suben/bajan si, en la misma
    // operación, se crea/borra el registro de esa persona (no se pueden falsear).
    function okLikeDelta(postId) {
      let id = /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      let d = request.resource.data.likesCount - resource.data.likesCount;
      return (d == 1 && !exists(id) && existsAfter(id))
        || (d == -1 && exists(id) && !existsAfter(id));
    }

    function okViewDelta(postId) {
      let id = /databases/$(database)/documents/posts/$(postId)/views/$(request.auth.uid);
      return request.resource.data.views - resource.data.get('views', 0) == 1
        && !exists(id) && existsAfter(id);
    }

    function okReaction(t) {
      return t in ['love', 'like', 'sad', 'angry', 'wow', 'confused'];
    }

    // Freno anti-bots: cada publicación o comentario exige actualizar
    // users/<uid>.lastActionAt en el mismo lote, y solo si pasaron 6 segundos
    // desde la acción anterior.
    function spaced() {
      return request.time > myProfile().get('lastActionAt', timestamp.date(2000, 1, 1))
               + duration.value(6, 's')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.lastActionAt == request.time;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Nombres de usuario únicos (usernames/<nombre en minúsculas>).
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('[a-z0-9_]{3,20}')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.usernameLower == name;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Datos privados (correo): solo los ve su dueño y el admin.
    match /userPrivate/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Opiniones (estrellas): cualquiera crea la suya, solo el admin las lee.
    match /feedback/{id} {
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(
             ['userId', 'username', 'stars', 'reason', 'platform', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username == myProfile().username
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 500
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /users/{uid} {
      allow read: if signedIn();

      // Crear tu propio perfil: obligatorio haber aceptado los términos.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'username', 'usernameLower', 'bio', 'photoUrl',
             'favoriteGames', 'banned', 'acceptedTerms', 'termsVersion',
             'acceptedTermsAt', 'createdAt'])
        && request.resource.data.acceptedTerms == true
        && request.resource.data.termsVersion is int
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.banned == false
        && request.resource.data.username is string
        && request.resource.data.username.matches('[A-Za-z0-9_]{3,20}')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.bio == ''
        && request.resource.data.photoUrl == ''
        && request.resource.data.favoriteGames == [];

      // Editar solo bio, foto y juegos favoritos. 'banned' lo cambia el admin.
      allow update: if (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['email'])
          && !('email' in request.resource.data))
        || (request.auth.uid == uid
          && canWrite()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['bio', 'photoUrl', 'favoriteGames', 'email'])
          && (!('email' in request.resource.data))
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 160
          && okMedia(request.resource.data.photoUrl)
          && request.resource.data.favoriteGames is list
          && request.resource.data.favoriteGames.size() <= 10)
        || (request.auth.uid == uid
          && canWrite()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lastActionAt'])
          && request.resource.data.lastActionAt == request.time)
        || isAdmin();

      allow delete: if isAdmin();

      match /following/{other} {
        allow read: if signedIn();
        allow create: if canWrite() && request.auth.uid == uid
          && other != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if canWrite() && request.auth.uid == uid;
      }

      match /followers/{follower} {
        allow read: if signedIn();
        allow create: if canWrite() && request.auth.uid == follower
          && follower != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if canWrite() && request.auth.uid == follower;
      }

      // Solo tú ves y editas tu lista de bloqueados.
      match /blocked/{other} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if canWrite() && request.auth.uid == uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if canWrite()
        && request.resource.data.keys().hasOnly([
             'authorId', 'authorName', 'text', 'imageUrl', 'videoUrl',
             'linkUrl', 'groupId', 'description', 'views', 'pollOptions',
             'pollCounts', 'createdAt',
             'likesCount', 'commentsCount'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == myProfile().username
        && okText(request.resource.data.text, 500)
        && okMedia(request.resource.data.imageUrl)
        && okMedia(request.resource.data.videoUrl)
        && okLink(request.resource.data.linkUrl)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.views == 0
        && okPoll(request.resource.data.pollOptions, request.resource.data.pollCounts)
        && okGroup(request.resource.data.groupId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && spaced();

      // Cualquiera con permiso puede tocar solo los contadores (de 1 en 1);
      // el admin puede todo.
      allow update: if (canWrite()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'commentsCount', 'views', 'pollCounts'])
          && step('likesCount')
          && step('commentsCount')
          && step('views')
          && (!('likesCount' in request.resource.data.diff(resource.data).affectedKeys())
              || okLikeDelta(postId))
          && (!('views' in request.resource.data.diff(resource.data).affectedKeys())
              || okViewDelta(postId))
          && (!('pollCounts' in request.resource.data.diff(resource.data).affectedKeys())
              || okVote(postId)))
        || isAdmin();

      allow delete: if isAdmin()
        || (canWrite() && resource.data.authorId == request.auth.uid);

      // Reacciones: 'type' es love, like, sad, angry, wow o confused.
      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if canWrite() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt', 'type'])
          && okReaction(request.resource.data.type);
        allow update: if canWrite() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['type'])
          && okReaction(request.resource.data.type);
        allow delete: if canWrite() && request.auth.uid == uid;
      }

      // Votos de la encuesta: uno por persona, no se pueden cambiar.
      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if canWrite() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['option', 'createdAt'])
          && request.resource.data.option is int
          && request.resource.data.option >= 0
          && request.resource.data.option
               < get(/databases/$(database)/documents/posts/$(postId)).data.pollOptions.size()
          && request.resource.data.createdAt == request.time;
      }

      // Visitas: una por persona. Solo se pueden crear, nunca cambiar.
      match /views/{uid} {
        allow read: if signedIn();
        allow create: if canWrite() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt']);
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if canWrite()
          && request.resource.data.keys().hasOnly(
               ['authorId', 'authorName', 'text', 'parentId', 'replyToName',
                'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == myProfile().username
          && okText(request.resource.data.text, 300)
          && request.resource.data.get('parentId', '') is string
          && request.resource.data.get('parentId', '').size() <= 40
          && request.resource.data.get('replyToName', '') is string
          && request.resource.data.get('replyToName', '').size() <= 30
          && request.resource.data.createdAt == request.time
          && spaced();
        allow delete: if isAdmin()
          || (canWrite() && resource.data.authorId == request.auth.uid);
      }
    }

    // Chats privados: solo los dos participantes (id = uids ordenados con _).
    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if canWrite()
        && request.resource.data.keys().hasOnly(
             ['members', 'names', 'lastMessage', 'lastAt', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_'
                     + request.resource.data.members[1]
        && request.resource.data.names is map
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update: if canWrite()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'lastAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 100
        && request.resource.data.lastAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in chatId.split('_');
        allow create: if canWrite()
          && request.auth.uid in
               get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && okText(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // Grupos: cualquiera con cuenta puede crear uno y unirse.
    match /groups/{groupId} {
      allow read: if signedIn();

      allow create: if canWrite()
        && request.resource.data.keys().hasOnly([
             'name', 'description', 'ownerId', 'ownerName', 'membersCount',
             'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == myProfile().username
        && okText(request.resource.data.name, 40)
        && request.resource.data.name.size() >= 3
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && request.resource.data.membersCount == 1
        && request.resource.data.createdAt == request.time;

      // Solo cambia el contador de miembros, de 1 en 1.
      allow update: if canWrite()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['membersCount'])
        && step('membersCount');

      allow delete: if isAdmin()
        || (canWrite() && resource.data.ownerId == request.auth.uid);

      match /members/{uid} {
        allow read: if signedIn();
        allow create: if canWrite() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if canWrite() && request.auth.uid == uid;
      }
    }

    // Denuncias: cualquiera puede crear una; solo el admin las lee y resuelve.
    match /reports/{reportId} {
      allow create: if canWrite()
        && request.resource.data.keys().hasOnly([
             'type', 'targetId', 'postId', 'ownerId', 'reason', 'reporterId',
             'reporterName', 'preview', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName == myProfile().username
        && request.resource.data.type in ['post', 'comment', 'user']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.preview is string
        && request.resource.data.preview.size() <= 140
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
  }
}
